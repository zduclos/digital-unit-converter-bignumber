{
  "name": "digital-unit-converter-bignumber",
  "version": "2.0.0",
  "description": "Utility to simplify conversion of arbitrary-precision digital units of measurement",
  "author": "Zach Duclos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zduclos/digital-unit-converter-bignumber.git"
  },
  "bugs": {
    "url": "https://github.com/zduclos/digital-unit-converter-bignumber/issues"
  },
  "homepage": "https://github.com/zduclos/digital-unit-converter-bignumber#readme",
  "keywords": [
    "convert",
    "converter",
    "unit",
    "units",
    "digital",
    "data",
    "storage",
    "size",
    "measurement",
    "si",
    "iec",
    "binary",
    "decimal",
    "bit",
    "byte",
    "kilobyte",
    "kibibyte",
    "megabyte",
    "mebibyte",
    "gigabyte",
    "gibibyte",
    "terabyte",
    "tebibyte"
  ],
  "type": "commonjs",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/cjs/index.d.ts",
  "files": [
    "lib/**/*",
    "src/index.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      },
      "default": "./lib/cjs/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm run clean",
    "build": "npm run build:cjs && npm run build:esm && npm run build:esm-package",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:esm-package": "echo '{\"type\":\"module\"}' > lib/esm/package.json",
    "clean": "rm -rf lib coverage",
    "test": "jest",
    "test:cjs": "node -e \"const assert = require('node:assert/strict'); const { DataUnit } = require('digital-unit-converter-bignumber'); const { BigNumber } = require('bignumber.js'); assert(DataUnit.MEGABYTE.toBytes(BigNumber(1)).isEqualTo(1000000))\"",
    "test:esm": "node --input-type=module -e \"import assert from 'node:assert/strict'; import { DataUnit } from 'digital-unit-converter-bignumber'; import { BigNumber } from 'bignumber.js'; assert(DataUnit.MEGABYTE.toBytes(BigNumber(1)).isEqualTo(1000000))\"",
    "lint": "eslint 'src/**/*.ts' --quiet",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "npm run lint && npm run format:check && npm run build && npm test && npm run test:cjs && npm run test:esm",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "bignumber.js": "11.1.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}

